# ─────────────────────────────────────────────────────────────
# Configuration Firebase — À RECOPIER dans un fichier nommé .env
# ─────────────────────────────────────────────────────────────
# 1. Copiez ce fichier et renommez la copie en ".env" (sans .example)
# 2. Remplacez chaque valeur ci-dessous par celle de votre projet Firebase
#    (Console Firebase > Paramètres du projet > Vos applications > Config)
# 3. Le fichier .env n'est JAMAIS envoyé sur git (il est ignoré).

VITE_FIREBASE_API_KEY=votre_api_key
VITE_FIREBASE_AUTH_DOMAIN=votre_projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre_projet
VITE_FIREBASE_STORAGE_BUCKET=votre_projet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# Sécurité — App Check (voir README, section « Sécurité »)
# ─────────────────────────────────────────────────────────────
# Clé de site reCAPTCHA v3 (créée à l'étape App Check). Tant qu'elle est vide,
# App Check est inactif (pratique pour développer avant la config).
VITE_RECAPTCHA_SITE_KEY=
# Optionnel : jeton de debug pour tester App Check en local (npm run dev).
# Laissez vide si vous avez ajouté "localhost" aux domaines de la clé reCAPTCHA.
VITE_APPCHECK_DEBUG_TOKEN=
